# --- Database ---
# Local dev: postgres://user:pass@host:port/db
# Railway: paste the DATABASE_URL from the attached Postgres plugin
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minutes
# Set to "true" on Railway / any managed Postgres that requires SSL
PGSSL=false

# --- Auth ---
# Long random string. Generate one with: openssl rand -base64 64
JWT_SECRET=replace-me-with-a-long-random-string

# Legacy single owner. On first boot after the multi-user migration these are
# turned into a real user row and all existing data is assigned to it, so the
# owner keeps signing in with the same credentials. New signups don't need this.
# Set username freely; generate the bcrypt hash with:
#   npm run hash-password -- 'your-plaintext-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$replace.this.with.a.real.bcrypt.hash

# --- Google sign-in (optional) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console.
# Add your site to "Authorized JavaScript origins" (e.g. http://localhost:5173
# and your production URL). Then set the SAME client id in both places below:
#   - GOOGLE_CLIENT_ID       (server: verifies the Google ID token)
#   - VITE_GOOGLE_CLIENT_ID  (client: renders the "Continue with Google" button)
# Leave both blank to disable Google sign-in — email/password still works.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Server ---
PORT=3000
NODE_ENV=development

# Production only: the public origin of the deployed client (used for CORS).
# Leave blank in dev — the server proxies through Vite at localhost:5173.
# If the server itself also serves the built client (same origin), this can stay blank.
CLIENT_ORIGIN=
